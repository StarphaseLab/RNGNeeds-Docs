# Response headers for Cloudflare Workers static assets (copied into ./out by next build).
# Replaces headers() in next.config.mjs, plus the HSTS/CORS headers Vercel added itself.
/*
  X-Robots-Tag: index, follow
  X-Content-Type-Options: nosniff
  Strict-Transport-Security: max-age=63072000
  Access-Control-Allow-Origin: *

/llms.txt
  Content-Type: text/plain; charset=utf-8

/llms-full.txt
  Content-Type: text/plain; charset=utf-8

/*.md
  Content-Type: text/markdown; charset=utf-8

/.well-known/ai-plugin.json
  Content-Type: application/json; charset=utf-8

# Next.js build output is content-hashed, so it can be cached for good.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
